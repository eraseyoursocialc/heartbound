# Android signing key - never commit to a public repo
android/heartbound.keystore

# Git Credential Manager diagnostics. PUBLISH.bat does `git add -A`, so without
# this a stray run of `git-credential-manager diagnose` would put a log full of
# account and machine detail onto a public website.
gcm-diagnose.log

# Build outputs, regenerable from the .ps1 scripts
heartbound-web.zip
android/heartbound-apk.zip

# Copied into place by android/build.ps1 (12 MB of duplicated audio).
# assets/phaser.min.js is deliberately NOT ignored - it is vendored, and
# android/build.ps1 hard-fails if it is missing.
android/assets/*.mp3
android/assets/heartbound.html
